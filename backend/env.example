# TOTP secret er AES-GCM key (base64, 32 byte: "local-only-totp-key-not-for-prod")
TOTP_KEY=bG9jYWwtb25seS10b3RwLWtleS1ub3QtZm9yLXByb2Q=
# Cloudflare er test secret (shob shomoy pass; fail test e 2x0000000000000000000000000000000AA); local chhara config atkay (v1.20)
