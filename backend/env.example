# Local er jonno: cp backend/env.example backend/.env  (.env git e jay na; shob variable: design 13.5)
# Database: make db-up (infra/docker-compose.yml, infra/postgres/init.sql)
APP_ENV=local
ADDR=127.0.0.1:8080
DATABASE_URL=postgres://shop_app:shop_app@127.0.0.1:5433/shop?sslmode=disable
MIGRATE_DATABASE_URL=postgres://shop_owner:shop_owner@127.0.0.1:5433/shop?sslmode=disable
ADMIN_ORIGINS=http://localhost:3001
# Shudhu local; staging/production e: openssl rand -base64 32 (secret manager e)
JASPR_INTERNAL_SECRET=local-only-jaspr-internal-secret-change-me
# shop_credentials er AES-GCM key (base64, 32 byte). Shudhu local; staging/production e notun: openssl rand -base64 32
CREDENTIALS_KEY=bG9jYWwtb25seS1rZXktbm90LWZvci1wcm9kLTAwMDE=
# M4 login (13.5). Shudhu local; staging/production e notun: openssl rand -base64 32
OTP_SECRET=local-only-otp-secret-not-for-prod-0001
