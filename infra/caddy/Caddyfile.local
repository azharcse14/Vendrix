# Local https (13.1, v1.27): `make https`. `__Host-sid`/`__Host-asid` browser e shudhu https e thake,
# tai production er moto ekoi cookie naam, local e Caddy er nijer CA (`tls internal`).
# Browser e warning na chaile ekbar `caddy trust` (keychain e Caddy er local root CA; user nije chalay).
# Shop host: LOCAL_SHOP_HOSTS (space diye), default sobujbazar.localhost.
{
  local_certs
  skip_install_trust                 # system trust e nije hat dey na; `caddy trust` user er command
  auto_https disable_redirects       # :80 e listen na
  https_port 8443
  default_bind 127.0.0.1             # shudhu ei machine theke
  log {                              # error log o request uri dey (upstream down hole): token muche
    format filter {
      fields {
        request>uri query {
          delete token
        }
      }
    }
  }
}
(app_proxy) {                        # Caddyfile er moto: X-Forwarded-Proto https Caddy nijei dey
  header_up X-Real-IP {client_ip}
  header_up -X-Client-IP             # client nije boshate parbe na (3.2)
  header_up -X-Internal-Auth
}
# Print link er token query te (11.7 item 8, 13.3): access log e token muche.
(no_token_log) {
  log {
    format filter {
      fields {
        request>uri query {
          delete token
        }
      }
    }
  }
}
{$LOCAL_SHOP_HOSTS:sobujbazar.localhost} {
  import no_token_log
  reverse_proxy 127.0.0.1:8081 {     # make web (Jaspr)
    import app_proxy
  }
}
# Local chobi (11.7 item 9): STORAGE=local er UPLOAD_DIR (repo root theke; scripts/https.sh cd kore).
img.localhost {
  root * {$UPLOAD_DIR:backend/.data/uploads}
  file_server
}
# M7: admin.localhost (Flutter web admin ar /api), admin er code ashle ekhane block.
